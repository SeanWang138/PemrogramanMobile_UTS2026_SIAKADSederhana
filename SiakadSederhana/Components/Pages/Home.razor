@page "/"
@inject DosenService DosenService
@inject MahasiswaService MahasiswaService

<PageTitle>Beranda</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">Selamat Datang</h1>
        <p class="page-subtitle">Sistem Informasi Akademik Sederhana &mdash; kelola data dosen dan mahasiswa</p>
    </div>
</div>

@if (memuat)
{
    <div class="siakad-card">
        <LoadingSpinner Pesan="Memuat ringkasan data..." />
    </div>
}
else if (gagal)
{
    <div class="siakad-card">
        <ErrorAlert Pesan="@pesanGagal" CobaLagi="MuatData" />
    </div>
}
else
{
    <div class="stat-grid">
        <div class="stat-card">
            <span class="stat-ikon stat-ikon-biru">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M3 9.5 12 5l9 4.5-9 4.5-9-4.5Z"></path>
                    <path d="M6.5 11.8V16c0 1.5 2.5 2.7 5.5 2.7s5.5-1.2 5.5-2.7v-4.2"></path>
                </svg>
            </span>
            <div>
                <div class="stat-angka">@jumlahDosen</div>
                <div class="stat-label">Dosen Terdaftar</div>
            </div>
        </div>

        <div class="stat-card">
            <span class="stat-ikon stat-ikon-amber">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="9" cy="8" r="3"></circle>
                    <path d="M3.5 19c0-2.8 2.5-4.5 5.5-4.5s5.5 1.7 5.5 4.5"></path>
                    <circle cx="17" cy="9" r="2.2"></circle>
                    <path d="M16.2 14.6c2.3.2 4.3 1.7 4.3 4.4"></path>
                </svg>
            </span>
            <div>
                <div class="stat-angka">@jumlahMahasiswa</div>
                <div class="stat-label">Mahasiswa Terdaftar</div>
            </div>
        </div>

        <div class="stat-card">
            <span class="stat-ikon stat-ikon-hijau">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="10" cy="8" r="3.2"></circle>
                    <path d="M4 19c0-2.9 2.7-4.6 6-4.6 1.3 0 2.5.3 3.5.8"></path>
                    <path d="m15.5 17.5 1.8 1.8 3.2-3.6"></path>
                </svg>
            </span>
            <div>
                <div class="stat-angka">@jumlahWaliAktif</div>
                <div class="stat-label">Dosen Wali Aktif</div>
            </div>
        </div>
    </div>

    <div class="widget-grid mt-3">
        @* ---------- Widget 1: Analisis Beban Dosen Wali ---------- *@
        <section class="widget" aria-labelledby="judulBeban">
            <h2 id="judulBeban" class="widget-judul">Analisis Beban Dosen Wali</h2>
            <p class="widget-sub">Dosen tanpa bimbingan ditandai merah di urutan teratas, disusul beban terbanyak</p>

            <div class="daftar-beban" tabindex="0" aria-label="Daftar beban dosen wali, dapat digulir">
                @if (BebanDosen.Count == 0)
                {
                    <p class="text-muted small mb-0 px-1">Belum ada data dosen.</p>
                }
                else
                {
                    @foreach (var b in BebanDosen)
                    {
                        <div class="beban-baris">
                            <div class="beban-nama">
                                <strong>@b.NamaDosen</strong>
                                <span class="beban-prodi">@b.Prodi</span>
                            </div>
                            <div class="beban-kanan">
                                @if (b.JumlahBimbingan == 0)
                                {
                                    <span class="badge-kosong">Belum Ada Bimbingan</span>
                                }
                                else
                                {
                                    <span class="beban-jumlah">@b.JumlahBimbingan mahasiswa</span>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </section>

        @* ---------- Widget 2: Distribusi Angkatan & Masa Studi ---------- *@
        <section class="widget" aria-labelledby="judulAngkatan">
            <h2 id="judulAngkatan" class="widget-judul">Distribusi Angkatan &amp; Masa Studi</h2>
            <p class="widget-sub">Jumlah dan persentase mahasiswa per angkatan (2020&ndash;2026)</p>

            @if (jumlahMahasiswa == 0)
            {
                <p class="text-muted small mb-0">Belum ada data mahasiswa.</p>
            }
            else
            {
                @foreach (var a in DistribusiAngkatan)
                {
                    <div class="angkatan-baris">
                        <span class="angkatan-label">
                            @a.Angkatan
                            @if (a.Angkatan <= 2020)
                            {
                                <span class="badge-perhatian">Perhatian Khusus</span>
                            }
                        </span>
                        <div class="batang-track" role="img"
                             aria-label="Angkatan @a.Angkatan: @a.Jumlah mahasiswa, @a.PersenText">
                            <div class="batang-isi @(a.Angkatan <= 2020 ? "batang-perhatian" : "")"
                                 style="width:@($"{a.Persen}%")"></div>
                        </div>
                        <span class="angkatan-teks">@($"{a.Jumlah} mahasiswa · {a.PersenText}")</span>
                    </div>
                }
            }
        </section>
    </div>

    <div class="stat-grid mt-3">
        <a href="dosen" class="modul-card">
            <span class="stat-ikon stat-ikon-biru">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M3 9.5 12 5l9 4.5-9 4.5-9-4.5Z"></path>
                    <path d="M6.5 11.8V16c0 1.5 2.5 2.7 5.5 2.7s5.5-1.2 5.5-2.7v-4.2"></path>
                </svg>
            </span>
            <div>
                <p class="modul-judul">Modul Dosen</p>
                <p class="modul-desc">Tambah, ubah, hapus, dan telusuri data dosen beserta prodi dan NIDN-nya.</p>
            </div>
        </a>

        <a href="mahasiswa" class="modul-card">
            <span class="stat-ikon stat-ikon-amber">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="9" cy="8" r="3"></circle>
                    <path d="M3.5 19c0-2.8 2.5-4.5 5.5-4.5s5.5 1.7 5.5 4.5"></path>
                    <circle cx="17" cy="9" r="2.2"></circle>
                    <path d="M16.2 14.6c2.3.2 4.3 1.7 4.3 4.4"></path>
                </svg>
            </span>
            <div>
                <p class="modul-judul">Modul Mahasiswa</p>
                <p class="modul-desc">Kelola data mahasiswa beserta pemilihan dosen wali melalui dropdown.</p>
            </div>
        </a>
    </div>
}

@code {
    private List<SiakadSederhana.Models.Dosen> daftarDosen = new();
    private List<SiakadSederhana.Models.Mahasiswa> daftarMahasiswa = new();
    private int jumlahDosen;
    private int jumlahMahasiswa;
    private int jumlahWaliAktif;
    private bool memuat = true;
    private bool gagal;
    private string? pesanGagal;

    private sealed record BarisBeban(int DosenId, string NamaDosen, string Prodi, int JumlahBimbingan);
    private sealed record BarisAngkatan(int Angkatan, int Jumlah, double Persen, string PersenText);

    /// <summary>Urutan: dosen tanpa bimbingan (badge merah) di atas, lalu beban terbanyak menurun.</summary>
    private List<BarisBeban> BebanDosen
    {
        get
        {
            var perDosen = daftarMahasiswa
                .GroupBy(m => m.DosenId)
                .ToDictionary(g => g.Key, g => g.Count());

            return daftarDosen
                .Select(d => new BarisBeban(
                    d.DosenId, d.NamaDosen, d.Prodi,
                    perDosen.GetValueOrDefault(d.DosenId, 0)))
                .OrderBy(b => b.JumlahBimbingan > 0) // false (0 bimbingan) → urutan pertama
                .ThenByDescending(b => b.JumlahBimbingan)
                .ThenBy(b => b.NamaDosen, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
    }

    /// <summary>Jumlah + persentase mahasiswa per angkatan untuk rentang 2020-2026.</summary>
    private List<BarisAngkatan> DistribusiAngkatan
    {
        get
        {
            var total = daftarMahasiswa.Count;
            var perTahun = daftarMahasiswa
                .GroupBy(m => m.Angkatan)
                .ToDictionary(g => g.Key, g => g.Count());

            var hasil = new List<BarisAngkatan>();
            for (var th = 2020; th <= 2026; th++)
            {
                var jumlah = perTahun.GetValueOrDefault(th, 0);
                var persen = total == 0 ? 0 : Math.Round(jumlah * 100.0 / total, 1);
                hasil.Add(new BarisAngkatan(th, jumlah, persen, $"{persen:0.#}%"));
            }
            return hasil;
        }
    }

    protected override Task OnInitializedAsync() => MuatData();

    private async Task MuatData()
    {
        memuat = true;
        gagal = false;
        pesanGagal = null;
        StateHasChanged();

        var hasilDosen = await DosenService.GetSemuaAsync();
        var hasilMahasiswa = await MahasiswaService.GetSemuaAsync();

        memuat = false;

        if (!hasilDosen.Berhasil || hasilDosen.Data is null)
        {
            gagal = true;
            pesanGagal = hasilDosen.Pesan ?? "Gagal memuat jumlah data dosen.";
            return;
        }

        if (!hasilMahasiswa.Berhasil || hasilMahasiswa.Data is null)
        {
            gagal = true;
            pesanGagal = hasilMahasiswa.Pesan ?? "Gagal memuat jumlah data mahasiswa.";
            return;
        }

        daftarDosen = hasilDosen.Data;
        daftarMahasiswa = hasilMahasiswa.Data;

        // Angka dihitung dari data aktual yang dikembalikan API, bukan hardcoded.
        jumlahDosen = daftarDosen.Count;
        jumlahMahasiswa = daftarMahasiswa.Count;
        jumlahWaliAktif = daftarMahasiswa.Select(m => m.DosenId).Distinct().Count();
    }
}
