@if (Visible)
{
    <div class="dialog-overlay" @onclick="Batal">
        <div class="dialog-box" role="alertdialog" aria-modal="true" aria-labelledby="dialogJudul"
             @onclick:stopPropagation="true">
            <span class="dialog-ikon dialog-ikon-merah">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M4 7h16M10 7V5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v2M6 7l1 12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-12M10 11v6M14 11v6"></path>
                </svg>
            </span>
            <h5 class="dialog-judul" id="dialogJudul">@Judul</h5>
            <p class="dialog-pesan">@Pesan</p>
            @if (!string.IsNullOrWhiteSpace(Detail))
            {
                <p class="dialog-detail">@Detail</p>
            }
            <div class="dialog-aksi">
                <button type="button" class="btn btn-outline-secondary" @onclick="Batal" disabled="@Sibuk">
                    Batal
                </button>
                <button type="button" class="btn btn-danger" @onclick="Konfirmasi" disabled="@Sibuk">
                    @if (Sibuk)
                    {
                        <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                    }
                    @TeksKonfirmasi
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public string Judul { get; set; } = "Konfirmasi Hapus";
    [Parameter] public string Pesan { get; set; } = "Yakin ingin menghapus data ini?";
    [Parameter] public string? Detail { get; set; }
    [Parameter] public string TeksKonfirmasi { get; set; } = "Hapus";
    [Parameter] public bool Sibuk { get; set; }
    [Parameter] public EventCallback OnKonfirmasi { get; set; }

    private Task Batal() => VisibleChanged.InvokeAsync(false);

    private Task Konfirmasi() => OnKonfirmasi.InvokeAsync();
}
